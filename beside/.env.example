# ollama (default, free/local) | openai
LLM_PROVIDER=ollama

# fast = 1 model call (recommended) | crew = 4 CrewAI agents
MENTOR_MODE=fast

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_NAME=gpt-4o-mini