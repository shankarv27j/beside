# ollama (default, free/local) | openai | groq
LLM_PROVIDER=ollama

# fast = 1 model call (recommended) | crew = 4 CrewAI agents
MENTOR_MODE=fast

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_NAME=gpt-4o-mini

# --- Groq (free tier, fast) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
# Smarter: openai/gpt-oss-120b  or  qwen/qwen3.6-27b
# Note: llama-3.1-8b-instant / llama-3.3-70b-versatile were retired Aug 16 2026

# --- LiveKit (voice classroom) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
